    "gitDecoration.modifiedResourceForeground": "#5795a0",
    "gitDecoration.deletedResourceForeground": "#b5647b",
    "gitDecoration.untrackedResourceForeground": "#eb9e35",
    "gitDecoration.ignoredResourceForeground": "#9994a6"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#9994a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#eb9e35"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#d8837f"
      }
    },
    {
      "scope": ["keyword"],
      "settings": {
        "foreground": "#b5647b"
      }
    },
    {
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#5795a0"
      }
    },
    {
      "scope": ["entity.name.type"],
      "settings": {
        "foreground": "#917baa"
      }
    },
    {
      "scope": ["variable"],
      "settings": {
        "foreground": "#58537a"
      }
    }
  ]
}
