    "terminal.ansiWhite": "#58537a",
    "terminal.ansiBrightBlack": "#9994a6",
    "terminal.ansiBrightRed": "#b5647b",
    "terminal.ansiBrightGreen": "#296a84",
    "terminal.ansiBrightYellow": "#eb9e35",
    "terminal.ansiBrightBlue": "#917baa",
    "terminal.ansiBrightMagenta": "#d8837f",
