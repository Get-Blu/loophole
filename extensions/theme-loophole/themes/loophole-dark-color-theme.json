    "gitDecoration.modifiedResourceForeground": "#9dd0d9",
    "gitDecoration.deletedResourceForeground": "#ec7093",
    "gitDecoration.untrackedResourceForeground": "#f7c278",
    "gitDecoration.ignoredResourceForeground": "#6f6b87"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#6f6b87",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#f7c278"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ecbdbb"
      }
    },
    {
      "scope": ["keyword"],
      "settings": {
        "foreground": "#ec7093"
      }
    },
    {
      "scope": ["entity.name.function"],
      "settings": {
        "foreground": "#9dd0d9"
      }
    },
    {
      "scope": ["entity.name.type"],
      "settings": {
        "foreground": "#c5a8e8"
      }
    },
    {
      "scope": ["variable"],
      "settings": {
        "foreground": "#e1dff4"
      }
    }
  ]
